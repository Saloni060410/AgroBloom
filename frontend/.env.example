# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:4000/api

# true runs the website on built-in sample data with no backend (standalone frontend work);
# false talks to the real backend at VITE_API_BASE_URL. Always false for a deployed build.
VITE_USE_MOCK=false

# Optional: credentials the landing page's "Demo dashboard" button signs in with.
# They ship in the browser bundle, so only ever use the seeded demo account.
# VITE_DEMO_EMAIL=kisan@khetgpt.in
# VITE_DEMO_PASSWORD=password123
