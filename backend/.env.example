# Local, standalone (npm run dev against a manually-run Postgres): copy this file to .env,
# generate two real secrets (openssl rand -hex 32) for the two JWT_* values below, then see
# AGENTS.md's Commands section.
#
# Local, one-command stack (docker compose up --build, from the repo root): same .env, but
# docker-compose.yml overrides DATABASE_URL and ML_SERVICE_URL to the in-network service names
# (postgres, ml) regardless of what's set here -- only the JWT secrets, CORS_ORIGIN and the
# weather/geocode/ML_MODE settings below actually take effect in that mode.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://khetgpt:khetgpt@localhost:5432/khetgpt
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8001

# "offline" serves backend/config/reference.dev.json instead of calling the
# ML service, so the frontend can be built without the ml/ container running.
# Milliseconds to wait for the ML service (raise to ~70000 if it runs on a host that sleeps it)
# ML_TIMEOUT_MS=5000
# Waits (ms) between retries of a reference-data request that fails quickly while the ML service starts.
# ML_RETRY_DELAYS_MS=2000,5000,10000
ML_MODE=online
WEATHER_SERVICE_URL=https://api.open-meteo.com/v1
GEOCODE_SERVICE_URL=https://geocoding-api.open-meteo.com/v1

# npm run db:seed:demo / npm run demo:reset (prisma/seed.js, backend/DEMO.md) -- the demo login
# used at the actual demo, never a real farmer's credentials. Not read by the running server
# itself (src/config/env.js's schema doesn't include these), only by the seed script. If unset,
# the seed script falls back to a built-in demo@khetgpt.local login and says so loudly -- set
# both here for anything beyond a quick local check.
DEMO_FARMER_EMAIL=demo@khetgpt.local
DEMO_FARMER_PASSWORD=change-me-demo-password
# Only needed if the seed script can't reach the backend at the default
# http://localhost:${PORT} (e.g. run from outside docker compose's default port mapping).
# DEMO_SEED_API_BASE_URL=http://localhost:4000